{
  "name": "slackctl",
  "version": "0.1.0",
  "description": "A Slack CLI driven by your own browser session — reads and replies without marking conversations as read.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "slackctl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/daemon.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
